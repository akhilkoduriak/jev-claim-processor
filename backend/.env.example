# Copy this file to backend/.env and fill in your key. backend/.env is not committed.
PORT=5000

# Jev API
# TypeSafe's own API: key from https://console.typesafe.ai/keys
JEV_API_KEY=your_jev_api_key_here
JEV_API_URL=https://api.typesafe.ai/v1
JEV_API_PATH=/systemone
# A jv_live_ key from jevtypesafeai.com (an independent reseller, not affiliated
# with TypeSafe AI) uses the same format at a different address:
#   JEV_API_URL=https://jevtypesafeai.com/api/v1
#   JEV_API_PATH=/decide

# true = never call Jev; always use the fallback rules
USE_MOCK_JEV=false

# Optional: pin a Jev model version, e.g. jev-1.13.0 (default: jev-latest)
JEV_MODEL=

# Policy rules applied to every decision
HIGH_VALUE_REVIEW_THRESHOLD=50000
MIN_AUTO_DECISION_CONFIDENCE=0.6

# ---------- Jev vs LLM comparison (Jev vs LLM page, node compare-llm.js) ----------
# Which LLM to compare Jev against: anthropic or openai
LLM_PROVIDER=anthropic

# Claude: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=
# Only if your key is not scoped to a workspace: Console > Settings > Workspaces (starts with wrkspc_)
ANTHROPIC_WORKSPACE_ID=
ANTHROPIC_MODEL=claude-opus-5
# Leave "low" for a classification task; set it empty to send no effort setting
ANTHROPIC_EFFORT=low

# OpenAI: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-sol
# Only for reasoning models, e.g. low / medium / high
OPENAI_REASONING_EFFORT=
