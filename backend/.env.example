# Copy this file to backend/.env and fill in your key. backend/.env is not committed.
PORT=5000

# Jev API
# TypeSafe's own API: key from https://console.typesafe.ai/keys
JEV_API_KEY=your_jev_api_key_here
JEV_API_URL=https://api.typesafe.ai/v1
JEV_API_PATH=/systemone
# A jv_live_ key from jevtypesafeai.com (an independent reseller, not affiliated
# with TypeSafe AI) uses the same format at a different address:
#   JEV_API_URL=https://jevtypesafeai.com/api/v1
#   JEV_API_PATH=/decide

# true = never call Jev; always use the fallback rules
USE_MOCK_JEV=false

# Optional: pin a Jev model version, e.g. jev-1.13.0 (default: jev-latest)
JEV_MODEL=

# Policy rules applied to every decision
HIGH_VALUE_REVIEW_THRESHOLD=50000
MIN_AUTO_DECISION_CONFIDENCE=0.6
